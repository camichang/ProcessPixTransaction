          "title": "Taxa de erros (%)",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear"
            },
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8008117
                ],
                "query": "SELECT percentage(count(*), WHERE error IS TRUE) AS 'Error Rate (%)'\r\nFROM Transaction\r\nWHERE appName = 'pix-transaction-service'\r\nSINCE 5 minutes ago\r\n"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
